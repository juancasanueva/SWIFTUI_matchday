    "Personal project. Not affiliated with ESPN or any league or club." : {
      "comment" : "About window footer disclaimer.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privates Projekt. Nicht mit ESPN, einer Liga oder einem Verein verbunden."
          }
        },
        "es" : {
          "stringUnit" : {

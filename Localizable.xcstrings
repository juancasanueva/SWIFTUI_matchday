    "Channels marked per match come from ESPN's US listings; the rest show the %@ league rights holders until the channel is posted." : {
      "comment" : "Footnote under the matches in the US. The argument is the season, e.g. 2026-27.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro Spiel markierte Sender stammen aus dem US-Programm von ESPN; sonst werden die Rechteinhaber der Liga für die Saison %@ angezeigt, bis der Sender feststeht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los canales marcados en cada partido proceden de la programación de ESPN en EE. UU.; el resto muestra los titulares de derechos de la liga en la temporada %@ hasta que se anuncie el canal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chaînes indiquées par match proviennent des programmes d'ESPN aux États-Unis ; les autres affichent les détenteurs des droits du championnat pour la saison %@ jusqu'à l'annonce de la chaîne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I canali indicati per partita provengono dai palinsesti ESPN negli USA; per il resto sono mostrati i detentori dei diritti del campionato per la stagione %@ finché il canale non viene annunciato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試合ごとのチャンネルはESPNの米国番組表によるものです。それ以外は、チャンネルが発表されるまで%@シーズンのリーグ放映権保有者を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경기별로 표시된 채널은 ESPN 미국 편성표 기준입니다. 나머지는 채널이 발표될 때까지 %@ 시즌 리그 중계권사를 표시합니다."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os canais assinalados por jogo vêm da programação da ESPN nos EUA; os restantes mostram os detentores dos direitos da liga na época %@ até o canal ser anunciado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按场次标注的频道来自 ESPN 美国节目表；其余在频道公布前显示 %@ 赛季的联赛转播权方。"
          }
        }
      }
    },
